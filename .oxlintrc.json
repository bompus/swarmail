{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true
      }
    ],
    "no-unused-expressions": [
      "error",
      {
        "allowTernary": true,
        "allowShortCircuit": true
      }
    ],
    "unicorn/no-new-array": "off",
    "unicorn/no-useless-spread": "off",
    "eslint/array-callback-return": "error",
    "eslint/curly": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-var": "error",
    // Style only: substring and slice both work. The shared baseline has no warn-level rules,
    // so each former warn rule is an error when it catches bugs and off when it is only style.
    "unicorn/prefer-string-slice": "off",
    "eslint/no-throw-literal": "error",
    "eslint/no-unsafe-optional-chaining": [
      "error",
      {
        "disallowArithmeticOperators": true
      }
    ],
    "eslint/no-useless-assignment": "error",
    "eslint/no-useless-catch": "error",
    "eslint/prefer-promise-reject-errors": "error",
    "eslint/preserve-caught-error": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "promise/no-return-in-finally": "error",
    "promise/no-callback-in-promise": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/prefer-ts-expect-error": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-unreadable-array-destructuring": "error",
    "unicorn/no-useless-iterator-to-array": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-structured-clone": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": [
              "test",
              "describe",
              "it",
              "suite",
              "before",
              "after",
              "beforeEach",
              "afterEach"
            ]
          }
        ]
      }
    ],
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 999,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    // Size limits are style, not bug checks, so they are off for the same reason;
    // max-lines above stays an error.
    "max-depth": "off",
    "max-lines-per-function": "off",
    "max-params": "off"
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "overrides": [
    {
      // Tests build mocks and loose test data, so the type-strictness rules below are off there,
      // along with the file-length limit. The bug checks (floating promises, unnecessary
      // conditions and the rest) stay on.
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "rules": {
        "max-lines": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
