{
  "name": "swarmail",
  "version": "0.2.5",
  "private": true,
  "description": "Local mail, roster and file reservations for coding-agent sessions on one machine, served over MCP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt",
    "check": "oxfmt --check && oxlint --deny-warnings . && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  }
}
